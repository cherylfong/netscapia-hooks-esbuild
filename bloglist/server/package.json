    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "eslint-plugin-react": "^7.37.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "mongoose": "^8.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.0.0",
    "prettier": "3.9.6",
    "supertest": "^7.2.2"
  }
